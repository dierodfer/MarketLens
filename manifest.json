{
  "manifest_version": 3,
  "name": "MarketLens",
  "version": "0.2.0",
  "description": "Filtra anuncios reservados, compara precios y bloquea vendedores en Wallapop",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "*://api.wallapop.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://es.wallapop.com/*",
        "*://www.wallapop.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MarketLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "inject.js"
      ],
      "matches": [
        "*://es.wallapop.com/*",
        "*://www.wallapop.com/*"
      ]
    }
  ]
}
